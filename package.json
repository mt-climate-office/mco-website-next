{
  "name": "mco-website-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "check:paths": "node scripts/check-paths.mjs",
    "check:kit": "node scripts/check-kit.mjs",
    "check:built": "node scripts/check-built.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "verify": "node scripts/verify.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "gen:api": "node scripts/gen-api.mjs",
    "test:newsletter": "node --test \"scripts/newsletter/test/*.test.mjs\"",
    "newsletter:preview": "node scripts/newsletter/send.mjs --dry-run --out previews",
    "gen:cms": "node scripts/generate-pages-yml.mjs",
    "check:cms": "node scripts/generate-pages-yml.mjs --check",
    "publications:refresh": "node scripts/publications-refresh.mjs",
    "check:publications": "node scripts/publications-refresh.mjs --check",
    "check:redirects": "node scripts/check-redirects.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "astro": "7.3.8",
    "mesonet-compliance": "github:mt-climate-office/mesonet-compliance#v0.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@types/node": "24.19.1",
    "cheerio": "1.2.0",
    "chrome-launcher": "1.2.1",
    "html-validate": "11.16.2",
    "lighthouse": "13.5.0",
    "marked": "18.1.0",
    "mjml": "5.4.1",
    "openapi-typescript": "7.13.0",
    "pagefind": "1.5.2",
    "playwright": "1.64.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
