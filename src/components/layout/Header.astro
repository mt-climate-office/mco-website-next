---
// Kit navbar (HOUSE-STYLE §3): logo → divider → brand → controls → nav-meta.
// is-sticky because pages scroll. On compact the section links move into an
// MCO.initDrawer drawer so the bar stays one row (src/scripts/chrome.ts).
import { NAV } from '../../lib/nav';
import { sitePath, url } from '../../lib/paths';

const here = sitePath(Astro.url.pathname);
const current = (path: string) => here === path || here.startsWith(path);
---
<header class="mco-navbar is-sticky">
  <a href={url()} class="logo-link" aria-label="Montana Climate Office">
    <img class="logo-img" src={url('mco-logo.png')} alt="" width="40" height="40">
  </a>
  <div class="nav-divider" aria-hidden="true"></div>
  <div class="brand">
    <p class="brand-title">Montana Climate Office</p>
  </div>

  <nav class="controls site-nav" aria-label="Main">
    <ul>
      {NAV.map((item) => (
        <li>
          <a class="nav-btn" href={url(item.path)} aria-current={current(item.path) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="nav-meta">
    <!-- Search is its own page (src/pages/search.astro), so the bar carries a
         link, not a field: no Pagefind bytes load until someone searches. -->
    <a class="nav-btn icon-only" id="btn-search" href={url('search/')} aria-label="Search"
       aria-current={here === 'search/' ? 'page' : undefined}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
    </a>
    <button type="button" class="nav-btn icon-only" id="btn-theme" aria-label="Switch theme">
      <svg id="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg id="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
      <svg id="icon-contrast" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
    </button>
    <button type="button" class="nav-btn icon-only site-menu-toggle" id="btn-menu"
            aria-label="Menu" aria-controls="site-drawer" aria-expanded="false">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>
</header>

<aside class="mco-drawer" id="site-drawer" data-side="end" aria-labelledby="site-drawer-title" hidden>
  <div class="mco-drawer-head">
    <h2 id="site-drawer-title" class="mco-panel-title">Menu</h2>
    <button type="button" class="modal-close" data-close-drawer aria-label="Close menu">×</button>
  </div>
  <div class="mco-drawer-body">
    <nav class="site-drawer-nav" aria-labelledby="site-drawer-title">
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={url(item.path)} aria-current={current(item.path) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</aside>
<div class="mco-scrim" id="site-scrim" aria-hidden="true" hidden></div>
