---
// One question and the tool that answers it. Copy follows docs/VOICE.md:
// every claim in `body` must be checkable against the tool itself.
interface Props {
  /** The question, as a reader would ask it. Rendered as an <h3>. */
  question: string;
  /** One or two sentences on what the tool shows. No figures that change. */
  body: string;
  /** Tool name, used as the link text. */
  tool: string;
  href: string;
  /** Status the tool itself shows, e.g. "beta". Printed in words. */
  status?: string;
}

const { question, body, tool, href, status } = Astro.props;
---
<article class="question">
  <h3>{question}</h3>
  <p>{body}</p>
  <p class="question-link">
    <a class="site-link" href={href}>{tool}</a>{status && <span class="question-status"> ({status})</span>}
  </p>
</article>

<style>
  /* A block, not a card: the grid gap is the separator (VISUAL-SYSTEM). */
  .question {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
  }
  .question h3 { font-size: var(--fs-xl); font-weight: var(--fw-semibold); line-height: 1.25; }
  .question p { max-width: 52ch; font-size: var(--fs-lg); line-height: var(--lh-body); color: var(--text-secondary); }
  .question-link { margin-top: auto; }
  .question-status { font-weight: var(--fw-regular); color: var(--text-secondary); }
</style>
