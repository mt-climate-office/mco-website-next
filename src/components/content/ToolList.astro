---
// Every public tool, one click from the homepage (rebuild plan Part 0,
// success criterion 2). Descriptions say what each tool shows, from the
// tool itself; no figures that change.
interface Tool {
  name: string;
  href: string;
  description: string;
  /** Status the tool itself shows, printed in words. */
  status?: string;
}

interface Props {
  tools: readonly Tool[];
}

const { tools } = Astro.props;
---
<ul class="tool-list">
  {tools.map((t) => (
    <li>
      <a class="site-link" href={t.href}>{t.name}</a>{t.status && <span class="tool-status"> ({t.status})</span>}
      <p>{t.description}</p>
    </li>
  ))}
</ul>

<style>
  .tool-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--site-grid-gap) var(--site-grid-gap-wide);
    list-style: none;
  }
  /* Held by space alone; no rule between tools (VISUAL-SYSTEM). */
  .tool-list li { min-width: 0; }
  .tool-list a { font-size: 1.25rem; }
  .tool-status { color: var(--text-secondary); }
  .tool-list p { margin-top: var(--space-2); font-size: 1rem; line-height: var(--lh-body); color: var(--text-muted); }
  /* Tools go one-up at the 1060 rung (VISUAL-SYSTEM, Breakpoints). */
  @media (max-width: 1060px) {
    .tool-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
