---
// Homepage hero: a station-camera set as a mosaic, with the page's <h1>
// over it, and the photo controls below it.
//
// The set arrives as a prop, computed at build time by the kit's
// MCO.photos (src/lib/photo-snapshot.ts): the most recent slot in the kit's
// default public range (first date 2026-10-22, DECISIONS D16), facing North.
// With JS, src/scripts/photo-hero.ts wires MCO.photos.initPhotoControls
// under it and swaps tiles in place when a visitor changes the date, time or
// direction. Without JS the build-time mosaic and its stamp show, and the
// controls stay hidden: absent, not dead.
//
// Absent `set`: a neutral, token-coloured grid and copy with no figures.
// Never fake photographs. The schedule and the counts are never written
// here; they come from the set.
import type { HeroSet, HeroStation } from '../../lib/photo-hero';
import { spread, TILE_COUNT } from '../../lib/photo-hero';
import { count, isoTime, stampMT } from '../../lib/format';

interface Props {
  set?: HeroSet | null;
  /** Every station with a public camera, west to east (the controls' lookup table). */
  stations?: HeroStation[];
}

const { set = null, stations = [] } = Astro.props;
const direction = set?.direction ?? 'north';

// Tiles spread evenly across the state, west to east. The grid fills by
// column, so columns run west to east; below 750px every other tile hides,
// which keeps the spread.
const tiles = set ? spread(set.tiles, TILE_COUNT) : [];
const cells = Array.from({ length: TILE_COUNT }, (_, i) => tiles[i] ?? null);
const PHOTO_EXPLORER = 'https://mesonet.climate.umt.edu/photos/';
// Thumbnail WebP size on data2 (the kit's frameUrl, size 'thumb').
const THUMB = { width: 320, height: 180 };
---
<section class="hero" aria-labelledby="hero-title">
  {set ? (
    <ul class="hero-mosaic" id="hero-mosaic" aria-label={`Station photos, west to east, facing ${direction}`}>
      {cells.map((t, i) => (
        <li>
          {t && (
            <img src={t.src} alt={t.alt} width={THUMB.width} height={THUMB.height}
                 loading={i % 3 === 0 ? 'eager' : 'lazy'} decoding="async">
          )}
        </li>
      ))}
    </ul>
  ) : (
    <div class="hero-mosaic is-empty" aria-hidden="true">
      {cells.map(() => <span></span>)}
    </div>
  )}
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-body">
    <div class="wrap">
      <div class="hero-copy">
        <h1 id="hero-title">Montana, looking <span data-hero="direction">{direction}</span></h1>
        {set ? (
          <p class="hero-lede">
            Cameras on <span data-hero="cameras">{count(set.cameraCount)}</span> stations photograph north,
            south, east and west through the day. This set has photos from <span data-hero="reported">{count(set.reportedCount)}</span> of them.
          </p>
        ) : (
          <p class="hero-lede">
            Station cameras photograph north, south, east and west through the day.
          </p>
        )}
        <p class="hero-actions">
          <a class="nav-btn is-primary site-cta" href={PHOTO_EXPLORER}>Open the Photo Explorer</a>
          <a class="nav-btn site-cta" href="#readings">See current readings</a>
        </p>
        {set && (
          <p class="stamp">
            <time data-hero="time" datetime={isoTime(set.slotAt)}>{stampMT(set.slotAt)}</time>
            {' · '}facing <span data-hero="facing">{direction}</span>
            {' · '}<span data-hero="ratio">{count(set.reportedCount)} of {count(set.cameraCount)}</span> cameras
          </p>
        )}
      </div>
    </div>
  </div>
</section>

{set && (
  <section class="photo-controls" id="photo-controls" aria-label="Photo controls" hidden
           data-date={set.slot.date} data-time={set.slot.time} data-view={set.view}
           data-stations={JSON.stringify(stations.map((s) => [s.id, s.name]))}>
    <div class="wrap pc-row">
      <div class="pc-field">
        <label for="pc-date">Date</label>
        <div class="pc-date">
          <button type="button" class="nav-btn mco-step" id="pc-prev" aria-label="Previous day">‹</button>
          <input type="date" id="pc-date" class="pc-input">
          <button type="button" class="nav-btn mco-step" id="pc-next" aria-label="Next day">›</button>
        </div>
      </div>
      <div class="pc-field">
        <label for="pc-time">Time</label>
        <select id="pc-time" class="pc-input"></select>
      </div>
      <div class="pc-field">
        <span class="pc-label" aria-hidden="true">Direction</span>
        <fieldset class="seg-btns is-radio" id="pc-views">
          <legend class="sr-only">Direction</legend>
        </fieldset>
        <label class="sr-only" for="pc-view">Direction</label>
        <select id="pc-view" class="pc-input" hidden></select>
      </div>
    </div>
  </section>
)}

<script>
  import '../../scripts/photo-hero';
</script>

<style>
  /* Mosaic, scrim and copy share one grid cell, so the hero is as tall as
     whichever is taller and the copy can never spill out of it. */
  .hero {
    display: grid;
    background: var(--bg-deep);
    border-bottom: 1px solid var(--border);
  }
  .hero > * { grid-area: 1 / 1; min-width: 0; }
  .hero-mosaic {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    /* Columns run west to east. */
    grid-auto-flow: column;
    /* Ten 4:3 tiles across, three down. */
    aspect-ratio: 40 / 9;
    min-height: 100%;
    gap: 3px;
    padding: 3px;
    list-style: none;
  }
  .hero-mosaic > * { min-width: 0; min-height: 0; background: var(--bg-raised); }
  .hero-mosaic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--bg-raised);
    transition: opacity var(--transition);
  }
  .hero-mosaic[aria-busy="true"] img { opacity: 0.6; }
  /* Empty state: plain surface tiles, so nothing reads as a photograph. */
  .hero-mosaic.is-empty > span {
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  /* The copy sits on a near-opaque wash of the page ground, so its contrast
     never depends on what a photo shows (HOUSE-STYLE §3: legibility never
     depends on a translucent fill). Solid across the copy column, fading
     only past it. */
  .hero-scrim {
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--bg-deep) 96%, transparent) 0,
      color-mix(in srgb, var(--bg-deep) 96%, transparent) min(42rem, 70%),
      color-mix(in srgb, var(--bg-deep) 40%, transparent) min(60rem, 88%),
      color-mix(in srgb, var(--bg-deep) 60%, transparent) 100%);
  }
  .hero-body {
    align-self: center;
    padding-block: var(--space-7);
  }
  .hero-copy { max-width: 36rem; }
  .hero h1 {
    margin-bottom: var(--space-5);
    font-size: calc(var(--fs-2xl) * 1.5);
    line-height: var(--lh-tight);
    font-weight: var(--fw-bold);
    letter-spacing: -0.02em;
  }
  .hero-lede {
    margin-bottom: var(--space-6);
    font-size: var(--fs-lg);
    line-height: var(--lh-body);
    color: var(--text-secondary);
    max-width: 48ch;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .hero .stamp { margin-top: var(--space-5); }

  /* Photo controls: a bar under the hero. */
  .photo-controls {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border);
  }
  .photo-controls[hidden] { display: none; }
  .pc-row {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-4) var(--space-6);
    padding-block: var(--space-5);
  }
  .pc-field { display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .pc-field > label, .pc-label {
    font-size: var(--fs-md);
    font-weight: var(--fw-medium);
    color: var(--text-secondary);
  }
  .pc-date { display: flex; gap: var(--space-2); align-items: stretch; }
  /* 40px tall at every width: the touch-target minimum (HOUSE-STYLE §5.5). */
  .pc-input {
    min-height: 40px;
    padding: 0 var(--space-3);
    background-color: var(--input-bg);
    color: var(--text-primary);
    border: 1px solid var(--ctrl-border);
    border-radius: var(--radius-md);
    font: inherit;
    font-size: var(--fs-md);
  }
  .pc-input[hidden] { display: none; }
  /* WebKit lowers a native <select>'s min-height to its font box (21px at
     390 with touch); an explicit height holds, and keeps the native arrow. */
  select.pc-input { min-width: 9rem; height: 40px; }
  .photo-controls .seg-btn { min-height: 40px; min-width: 40px; justify-content: center; }

  /* Below 1060 the copy would cover most of the mosaic: stack it below. */
  @media (max-width: 1060px) {
    .hero-scrim { display: none; }
    .hero > .hero-body { grid-area: 2 / 1; }
  }
  @media (max-width: 750px) {
    .hero-mosaic {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      aspect-ratio: 20 / 9;
    }
    /* Every other tile, so fifteen still span the state. */
    .hero-mosaic > :nth-child(even) { display: none; }
    .hero h1 { font-size: var(--fs-2xl); }
  }
</style>
