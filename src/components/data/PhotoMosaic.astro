---
// Homepage hero: the most recent West-facing station-camera set as a
// mosaic, with the page's <h1> over it (DECISIONS D22). No controls: every
// other view, date and time is in the Photo Explorer.
//
// The set arrives as a prop, computed at build time by the kit's
// MCO.photos (src/lib/photo-snapshot.ts): the most recent slot in the kit's
// default public range (first date 2026-10-22, DECISIONS D16), facing West.
// With JS, src/scripts/photo-hero.ts swaps in a newer set once it is in.
//
// The hero is a dark theme island in every page theme (kit 0.18.0,
// DECISIONS D23): photographs read best on a dark ground, and the copy over
// them keeps the dark theme's contrast. On a high-contrast page it is a
// high-contrast island instead (src/scripts/hero-theme.ts).
//
// The mosaic is one image to assistive technology (role="img", one
// sentence): ninety-six alt texts would be a list nobody wants read out.
//
// Absent `set`: a neutral, token-coloured grid and copy with no figures.
// Never fake photographs. The schedule and the counts are never written
// here; they come from the set.
import type { HeroSet, HeroStation } from '../../lib/photo-hero';
import { mosaicLabel, spread, TILE_COUNT } from '../../lib/photo-hero';
import { count, isoTime, stampMT } from '../../lib/format';
import { PHOTO_EXPLORER } from '../../lib/tools';

interface Props {
  set?: HeroSet | null;
  /** Every station with a public camera, west to east (the refresh's lookup table). */
  stations?: HeroStation[];
}

const { set = null, stations = [] } = Astro.props;
const direction = set?.direction ?? 'west';

// Tiles spread evenly across the state, west to east. The grid fills by
// column, so columns run west to east; below 750px every other tile hides,
// which keeps the spread.
const tiles = set ? spread(set.tiles, TILE_COUNT) : [];
const cells = Array.from({ length: TILE_COUNT }, (_, i) => tiles[i] ?? null);
// Thumbnail WebP size on data2 (the kit's frameUrl, size 'thumb').
const THUMB = { width: 320, height: 180 };
---
<section class="hero" data-theme="dark" aria-labelledby="hero-title">
  {set ? (
    <div class="hero-mosaic" id="hero-mosaic" role="img" aria-label={mosaicLabel(set)}
         data-slot-at={set.slotAt}
         data-stations={JSON.stringify(stations.map((s) => [s.id, s.name]))}>
      {cells.map((t, i) => (
        <span>
          {t && (
            <img src={t.src} alt="" width={THUMB.width} height={THUMB.height}
                 loading={i % 8 === 0 ? 'eager' : 'lazy'} decoding="async">
          )}
        </span>
      ))}
    </div>
  ) : (
    <div class="hero-mosaic is-empty" aria-hidden="true">
      {cells.map(() => <span></span>)}
    </div>
  )}
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-body">
    <div class="wrap">
      <div class="hero-copy">
        <h1 id="hero-title">Montana, looking <span data-hero="direction">{direction}</span></h1>
        <p class="hero-lede">
          The latest photo from each station camera, laid out west to east.
          Every direction and date is in the Photo Explorer.
        </p>
        <p class="hero-actions">
          <a class="nav-btn is-primary site-cta" href={PHOTO_EXPLORER}>Open the Photo Explorer</a>
          <a class="site-link" href="#readings">See current readings</a>
        </p>
        {set && (
          <p class="stamp">
            <time data-hero="time" datetime={isoTime(set.slotAt)}>{stampMT(set.slotAt)}</time>
            {' · '}facing <span data-hero="facing">{direction}</span>
            {' · '}<span data-hero="ratio">{count(set.reportedCount)} of {count(set.cameraCount)}</span> cameras
          </p>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hero-theme';
  import '../../scripts/photo-hero';
</script>

<style>
  /* Hero (VISUAL-SYSTEM, Hero): the mosaic full-bleed behind everything, at
     min(70vh, 760px), copy bottom-aligned, and the navbar over the top of
     it. Mosaic, scrim and copy share one grid cell, so the hero is as tall
     as whichever is taller and the copy can never spill out of it. It pulls
     up under the sticky navbar by the bar's height (--chrome-h, published
     by mco-core). */
  .hero {
    display: grid;
    min-height: min(70svh, 47.5rem);
    margin-top: calc(-1 * var(--chrome-h, 52px));
    background: var(--bg-deep);
  }
  .hero > * { grid-area: 1 / 1; min-width: 0; }
  /* Twelve columns of eight, filled by column, so columns run west to
     east. Small tiles: the mosaic reads as the state, not as photos to
     study (those are in the Photo Explorer). */
  .hero-mosaic {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(8, minmax(0, 1fr));
    grid-auto-flow: column;
    gap: 2px;
    list-style: none;
  }
  .hero-mosaic > * { min-width: 0; min-height: 0; background: var(--bg-raised); }
  .hero-mosaic img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--bg-raised);
    transition: opacity var(--transition);
  }
  .hero-mosaic[aria-busy="true"] img { opacity: 0.6; }

  /* Scrim, built from the island's --bg-deep, so it is dark in every page
     theme (D23). Bottom-up, so the photographs show. Where
     text sits it is at least 90% opaque, so contrast never depends on what
     a photo shows (HOUSE-STYLE §3): under the navbar (the spec's 28% fails
     the brand title over a bright sky), and behind the copy (.hero-body).
     Between the two the photos are left alone. */
  .hero-scrim {
    background: linear-gradient(180deg,
      color-mix(in srgb, var(--bg-deep) 90%, transparent) 0,
      color-mix(in srgb, var(--bg-deep) 90%, transparent) var(--chrome-h, 52px),
      color-mix(in srgb, var(--bg-deep) 10%, transparent) calc(var(--chrome-h, 52px) + 6rem),
      color-mix(in srgb, var(--bg-deep) 10%, transparent) 100%);
  }
  /* Behind the copy the wash rises from clear to 70% where the <h1> starts
     (large text: 3:1 over a white sky needs about 60%), and to 88% by the
     lede, so the lede, links and stamp clear 4.5:1 over any photo. */
  .hero-body {
    align-self: end;
    padding-block: 4rem;
    background: linear-gradient(180deg,
      transparent 0,
      color-mix(in srgb, var(--bg-deep) 70%, transparent) 4rem,
      color-mix(in srgb, var(--bg-deep) 88%, transparent) 10rem,
      color-mix(in srgb, var(--bg-deep) 96%, transparent) 100%);
  }
  .hero h1 {
    margin-bottom: var(--space-5);
    font-size: var(--site-fs-h1);
    line-height: 1.02;
    font-weight: var(--fw-bold);
    letter-spacing: -0.035em;
  }
  .hero-lede {
    max-width: 50ch;
    margin-bottom: var(--space-6);
    font-size: var(--site-fs-lede);
    line-height: 1.65;
    color: var(--text-secondary);
  }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-7); }
  .hero-actions .site-link { font-size: var(--fs-lg); }
  .hero .stamp { margin-top: var(--space-5); }

  /* The navbar over the hero: clear at the top of the page, its glass back
     once the page scrolls (a scroll-driven animation; the navbar is sticky,
     and over the readings below it needs the glass). Engines without
     scroll timelines, and visitors who ask for less transparency, keep the
     kit's glass bar throughout. */
  @supports (animation-timeline: scroll()) {
    @media not (prefers-reduced-transparency: reduce) {
      /* kit-override: the navbar's glass, border and gradient underline
         start clear on the homepage, so the photographs reach the top. */
      :global(.mco-navbar:has(~ main .hero)) {
        background: transparent;
        backdrop-filter: blur(0);
        border-bottom-color: transparent;
        animation: hero-nav-glass linear both;
      }
      :global(.mco-navbar:has(~ main .hero))::after {
        opacity: 0;
        animation: hero-nav-rule linear both;
      }
      /* The timeline in its own, more specific rule: the minifier folds a
         timeline into the animation shorthand, a form Chromium drops. */
      :global(html .mco-navbar:has(~ main .hero)),
      :global(html .mco-navbar:has(~ main .hero))::after {
        animation-timeline: scroll(root);
        animation-range: 0 4rem;
      }
    }
  }
  @keyframes hero-nav-glass {
    to {
      background: var(--glass);
      backdrop-filter: blur(16px);
      border-bottom-color: var(--border);
    }
  }
  @keyframes hero-nav-rule { to { opacity: 1; } }

  @media (max-width: 750px) {
    .hero-mosaic {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(12, minmax(0, 1fr));
    }
    /* Every other tile, so forty-eight still span the state. */
    .hero-mosaic > :nth-child(even) { display: none; }
    .hero-body { padding-bottom: 3rem; }
  }
</style>
