---
// Headline network figures (DECISIONS D10): station count, reporting count
// and percentage, and the health split with one line saying what "partial"
// means. Read from the mesonet-compliance summary JSON (D5); never computed
// here and never typed into the CMS.
//
// Not shown: maintenance compliance (D4, unresolved) and UMRB cells (not in
// D10). Figures are plain text; colour carries nothing here.
//
// Each figure comes before its label (.figures in site.css, shared with
// /mesonet/status/). A list, not a <dl>: a <dl> cannot put the value
// before its term.
//
// The homepage passes the build-time snapshot of the summary, shown with its
// timestamp (CLAUDE.md, "Fetch, don't frame"); the nightly rebuild keeps it
// fresh. Absent `summary`: a short notice, no figures.
import type { NetworkSummary } from './types';
import { count, isoTime, percent, stampMT } from '../../lib/format';
import { url } from '../../lib/paths';

interface Props {
  summary?: NetworkSummary | null;
  /** A landscape band for the section's ground (site.css, DECISIONS D29). */
  band?: 'band-sky' | 'band-prairie' | 'band-sage';
}

const { summary = null, band } = Astro.props;
const pct = summary ? percent(summary.reporting, summary.stations) : null;
const windowLabel = summary ? `${summary.reportingWindowHours} hour${summary.reportingWindowHours === 1 ? "" : "s"}` : "";
---
<section class:list={["net", band]} aria-labelledby="net-title">
  <div class="wrap net-inner">
    <h2 id="net-title" class="section-title">Station status</h2>

    {summary ? (
      <div class="net-body">
        <ul class="figures">
          <li>
            <span class="figure mco-num-display">{count(summary.stations)}</span>
            <span class="figure-label">Stations</span>
          </li>
          <li>
            <span class="figure mco-num-display">{count(summary.reporting)}</span>
            <span class="figure-label">Reported in the last {windowLabel}{pct != null && ` (${pct}%)`}</span>
          </li>
          <li>
            <span class="figure mco-num-display">{count(summary.health.operational)}</span>
            <span class="figure-label">Operational</span>
          </li>
          <li>
            <span class="figure mco-num-display">{count(summary.health.partial)}</span>
            <span class="figure-label">Partial sensor outage</span>
          </li>
          <li>
            <span class="figure mco-num-display">{count(summary.health.outage)}</span>
            <span class="figure-label">Total outage</span>
          </li>
        </ul>
        <p class="net-note">
          A station with a partial sensor outage is still reporting. At least one of its
          sensors is not.
        </p>
        <p class="stamp">As of <time datetime={isoTime(summary.generatedAt)}>{stampMT(summary.generatedAt)}</time></p>
      </div>
    ) : (
      <p class="mco-empty net-empty">Network figures are not available here yet.</p>
    )}

    <p class="net-links">
      <a class="site-link" href={url('mesonet/status/')}>Every station's status</a>
    </p>
  </div>
</section>

<style>
  /* Numerals on the page ground: no band, no border (VISUAL-SYSTEM). The
     homepage puts this after the readings, so it takes only the space
     below; the readings section's own padding is the gap above. */
  .net-inner { padding-block: 0 var(--site-section); }
  .net-body { margin-top: var(--site-head-gap); }
  .net-note {
    margin-top: 2.25rem;
    max-width: 60ch;
    font-size: var(--fs-lg);
    color: var(--text-secondary);
  }
  .net-body .stamp { margin-top: var(--space-3); }
  .net-empty { margin-top: var(--site-head-gap); justify-content: flex-start; text-align: left; }
  .net-links { margin-top: var(--space-6); font-size: var(--fs-lg); }
</style>
