---
// Site search. Pagefind builds a static index of every page's <main> after
// `astro build` (package.json "build"); src/scripts/search.ts loads it on the
// first query. The form is a plain GET to this page, so ?q= links work and
// the page still says what to do without JavaScript.
//
// The field uses the kit's .mco-search styling. MCO.initSearchBox is not used:
// it is a combobox that ranks a list of labels in memory (MCO.searchModel),
// and Pagefind is a full-text search that answers asynchronously with
// excerpts. Results are a list of links, which is what a results page is.
import Base from '../layouts/Base.astro';
import { NAV } from '../lib/nav';
import { url } from '../lib/paths';
---
<Base short="Search" description="Search the pages of the Montana Climate Office website."
      searchable={false} search>
  <div class="site-search">
    <h1 class="section-title">Search</h1>

    <form class="site-search-form" role="search" action={url('search/')} method="get">
      <label for="search-q" class="site-search-label">Search this site</label>
      <div class="site-search-row">
        <div class="mco-search">
          <span class="mco-search-icon" aria-hidden="true"></span>
          <input id="search-q" name="q" class="mco-search-input" type="search"
                 autocomplete="off" spellcheck="false" enterkeyhint="search">
        </div>
        <button type="submit" class="nav-btn is-primary site-cta">Search</button>
      </div>
    </form>

    <noscript>
      <p class="site-search-status">Search runs in your browser and needs JavaScript. The sections below are another way in.</p>
    </noscript>

    <p id="search-status" class="site-search-status" hidden></p>
    <ol id="search-results" class="site-search-results" aria-label="Search results" hidden></ol>
    <button type="button" id="search-more" class="nav-btn site-cta" hidden>Show more results</button>

    <nav class="site-search-sections" aria-labelledby="search-sections-title">
      <h2 id="search-sections-title" class="site-search-sections-title">Sections</h2>
      <ul>
        <li><a href={url()}>Home</a></li>
        {NAV.map((item) => <li><a href={url(item.path)}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>

<script>
  import '../scripts/search';
</script>
