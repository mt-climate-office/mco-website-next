---
// /research/ (rebuild plan §4.2): the featured publications, a link to the
// full list (the portal, §4.7, at /research/publications/), the active
// projects (/projects/), and the climate assessments. Titles are the link text (WCAG 2.4.4; the current page
// repeats "Read Article"). Featured is set per entry in the CMS.
import Base from '../../layouts/Base.astro';
import { authorList, getPublications, publicationPath } from '../../lib/publications';
import { getProjects, projectPath } from '../../lib/projects';
import { count } from '../../lib/format';
import { url } from '../../lib/paths';

const pubs = await getPublications();
const featured = pubs.filter((p) => p.featured);
const projects = (await getProjects()).filter((p) => p.status === 'active');
---
<Base short="Research"
      description="Papers with Montana Climate Office authors, the office's research projects, and the Montana Climate Assessment.">
  <!-- Copy drafted with AI assistance; needs MCO staff review before launch (UM AI disclosure). -->
  <h1 class="section-title">Research</h1>
  <p class="section-lede">
    Papers with Montana Climate Office authors, the projects they come from, and the Montana Climate Assessment
    reports the office worked on.
  </p>

  <section class="hub-section" aria-labelledby="research-pubs">
    <h2 id="research-pubs" class="hub-h2">Publications</h2>
    {featured.length > 0 && (
      <ul class="pub-list">
        {featured.map((p) => (
          <li>
            <p class="pub-title"><a href={url(publicationPath(p.slug))}>{p.title}</a></p>
            <p class="pub-meta">{authorList(p.authors, 6)}. {p.container ? <cite>{p.container}</cite> : p.publisher}, {p.year}.</p>
          </li>
        ))}
      </ul>
    )}
    <p class="pub-all">
      <a class="nav-btn site-cta" href={url('research/publications/')}>All {count(pubs.length)} publications, with filters and citations</a>
    </p>
  </section>

  <section class="hub-section" aria-labelledby="research-projects">
    <h2 id="research-projects" class="hub-h2">Projects</h2>
    <ul class="pub-list">
      {projects.map((p) => (
        <li>
          <p class="pub-title"><a href={url(projectPath(p.slug))}>{p.name}</a></p>
          <p class="pub-meta">{p.summary}</p>
        </li>
      ))}
    </ul>
    <p class="pub-all">
      <a class="nav-btn site-cta" href={url('projects/')}>All projects, active and completed</a>
    </p>
  </section>

  <section class="hub-section" aria-labelledby="research-mca">
    <h2 id="research-mca" class="hub-h2">Montana Climate Assessment</h2>
    {/* mco-website/_pages/climate.md lists both as climate projects of the
        office. Both URLs answered 200 on 22 Oct 2026. */}
    <ul class="pub-list">
      <li>
        <p class="pub-title"><a href="https://montanaclimate.org/chapter/title-page">2017 Montana Climate Assessment</a></p>
      </li>
      <li>
        <p class="pub-title"><a href="https://montanaclimate.org/c2h2_1introduction">2021 Report on Climate Change and Human Health</a></p>
      </li>
    </ul>
  </section>
</Base>
