---
// Homepage, per docs/VISUAL-SYSTEM.md and its comp
// (docs/design/homepage-reference.html), as DECISIONS D29 amends them:
// frameless, one station-camera photo as the hero, and the sections banded
// in the kit's landscape tones so no two adjacent ones share a ground.
//
// Each data component takes typed props (src/components/data/types.ts) and
// renders its empty state when they are absent. The status bar reads the
// mesonet-compliance summary at build time, and the photo hero takes the
// most recent public set from the kit's MCO.photos at build time (a failed
// fetch fails either, so the previous deploy stays up). The conditions card
// renders empty and is filled in the browser by the kit's place search
// (src/scripts/conditions-now.ts); without JavaScript it links to the
// Station Dashboard. The station map takes
// the build's /stations/ catalog and a /latest/ air-temperature snapshot (a
// failed fetch fails the build too) and refreshes itself in the browser.
// Never pass sample data
// here; the page must not show a made-up figure.
// Copy follows docs/VOICE.md. The drought and snow features' claims are
// sourced in src/pages/drought/index.astro, which says the same at length.
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/data/PhotoHero.astro';
import ConditionsNow from '../components/data/ConditionsNow.astro';
import NetworkStatusBar from '../components/data/NetworkStatusBar.astro';
import StationMap from '../components/data/StationMap.astro';
import ToolFeature from '../components/content/ToolFeature.astro';
import ToolList from '../components/content/ToolList.astro';
import { TOOLS, tool } from '../lib/tools';
import { loadSummary, toNetworkSummary } from '../lib/compliance';
import { loadHeroSnapshot } from '../lib/photo-snapshot';
import { buildSnapshot, getLatest } from '../lib/mesonet';
import { getCatalog } from '../lib/stations';
import { AIR_TEMP_ELEMENTS, joinLatest } from '../lib/station-map';
import { getNews } from '../lib/news-posts';
import { newsDate, newsPath } from '../lib/news';
import { url } from '../lib/paths';

const [summary, hero, catalog, latest] = await Promise.all([
  loadSummary().then(toNetworkSummary),
  loadHeroSnapshot(),
  getCatalog(),
  buildSnapshot('/latest/ air temperature', () => getLatest({ elements: AIR_TEMP_ELEMENTS, units: 'us' })),
]);
const mapStations = joinLatest(catalog.stations, latest.rows);
// The three newest public posts (owner, 25 Oct 2026: plan §4.2 puts news
// on the homepage; DECISIONS D24).
const news = (await getNews()).slice(0, 3);

---
<Base description="Weather, soil moisture, drought and snowpack data for Montana." fullBleed photos map places summary darkHero>
  <PhotoHero set={hero.set} stations={hero.stations} />

  <section id="readings" class="readings" aria-labelledby="readings-title">
    <div class="wrap readings-inner">
      <div class="readings-side">
        <div class="readings-text">
          <h2 id="readings-title" class="section-title">What the stations are reading</h2>
          <p class="section-lede">
            Every station reports the weather above it and the soil beneath it several times an hour.
            Search for a town or a station to see its latest readings.
            The newest values are provisional until we have checked them.
          </p>
        </div>
        <ConditionsNow />
      </div>
      <StationMap stations={mapStations} fetchedAt={latest.fetchedAt} />
    </div>
  </section>

  <NetworkStatusBar summary={summary} band="band-prairie" />

  <section class="section band-sky" aria-labelledby="dry-title">
    <div class="wrap">
      <h2 id="dry-title" class="section-title">Drought and snowpack</h2>
      <p class="section-lede">
        Drought can show up in the snowpack long before it reaches the soil, so we track both, every day.
      </p>
      <div class="features">
        <ToolFeature name="D³ Drought Data Dashboard" href={tool('D³ Drought Data Dashboard').href} shot="d3-drought" status="beta">
          <p>
            Daily drought maps for Montana and the rest of the lower 48, from rainfall alone to how hard the air is pulling water out of the ground.
            Any of them can be read over the last two weeks or the last two years.
          </p>
        </ToolFeature>
        <ToolFeature name="Snowpack Explorer" href={tool('Snowpack Explorer').href} shot="snowpack" flip>
          <p>
            Today’s snowpack set against the same date in every winter since 2003, mapped across the mountains or added up for a whole watershed.
          </p>
        </ToolFeature>
      </div>
      <p class="features-more"><a class="site-link" href={url('drought/')}>More on drought</a></p>
    </div>
  </section>

  <!--
    "Where people usually start" audience cards go with the /for/ hubs,
    which are not built for launch (DECISIONS D24).
  -->

  <section class="section" aria-labelledby="tools-title">
    <div class="wrap">
      <h2 id="tools-title" class="section-title">All our tools</h2>
      <ToolList tools={TOOLS} />
    </div>
  </section>

  {news.length > 0 && (
    <section class="section band-sage" aria-labelledby="news-title">
      <div class="wrap">
        <h2 id="news-title" class="section-title">News</h2>
        <ul class="news-list">
          {news.map(({ data, slug, category }) => {
            const d = newsDate(data.date);
            return (
              <li class="news-item">
                <article aria-labelledby={`home-post-${slug}`}>
                  <h3 class="news-item-title" id={`home-post-${slug}`}>
                    <a href={url(newsPath(slug))}>{data.title}</a>
                  </h3>
                  <p class="stamp news-meta"><time datetime={d.iso}>{d.label}</time> · {category}</p>
                  <p class="news-item-summary">{data.summary}</p>
                </article>
              </li>
            );
          })}
        </ul>
        <p class="news-all"><a class="site-link" href={url('news/')}>All news</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .news-all { margin-top: var(--site-head-gap); }
  .readings-inner {
    display: grid;
    /* Copy and the conditions beside the map, as in the reference comp.
       Near-even columns, so the map is not twice the height of the copy
       while no station is picked. */
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--site-grid-gap-wide);
    align-items: start;
    padding-block: var(--site-section);
  }
  .readings-side { display: grid; gap: var(--site-grid-gap); align-content: start; min-width: 0; }
  .features { margin-top: var(--site-head-gap); }
  .features-more { margin-top: var(--site-head-gap); }
  #tools-title { margin-bottom: var(--site-head-gap); }
  @media (max-width: 1060px) {
    .readings-inner { gap: var(--site-grid-gap); }
  }
  @media (max-width: 750px) {
    .readings-inner { grid-template-columns: minmax(0, 1fr); }
  }
</style>
